NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
GAMEBUDDY_ENV=development
# Required only to unlock private Ops/memory in production. Never use NEXT_PUBLIC_ for this secret.
GAMEBUDDY_ADMIN_TOKEN=
# Render Free uses ephemeral storage; local development defaults to persistent.
GAMEBUDDY_STORAGE_DURABILITY=persistent
GAMEBUDDY_MAX_REQUEST_BYTES=262144
# Optional; defaults to backend/data when not set. Keep this private and persistent.
GAMEBUDDY_DATA_DIR=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3002
OPENROUTER_APP_NAME=GameBuddy Agent
MONGODB_URI=
MONGODB_DATABASE=gamebuddy
MONGODB_USER_PROFILES_COLLECTION=user_profiles
MONGODB_ANALYSIS_HISTORY_COLLECTION=analysis_history
MONGODB_FEEDBACK_COLLECTION=feedback
